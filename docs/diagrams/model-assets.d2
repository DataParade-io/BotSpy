title: Model assets - one-time download, digest-verified

remote: {
  label: "Hugging Face\nXenova/all-MiniLM-L6-v2\n\nmodel_quantized.onnx\nsha256 afdb6f1a0e45b715d0bb9b11772f032c399babd23bfc31fed1c170afc848bdb1\n\ntokenizer.json\nsha256 da0e79933b9ed51798a3ae27893d3c5fa4a201126cef75586296df9b4d2c62a0"
  class: tool
}

setup: {
  label: "cargo run --example setup_models\n\nRun from a matching source checkout.\nExplicit and idempotent.\nDownloads only when a file is\nmissing or its digest is wrong.\nCI runs the same step before tests."
  class: tool
}

part: {
  label: "Temporary file\n*.part\n\nThe download lands in a .part file.\nIt is renamed only when the\nsha256 digest matches."
  class: tool
}

cache: {
  label: "Model cache\n\nRoot: BOTSPY_MODELS, otherwise\n\$HOME/.botspy/models\nSubdirectory: all-MiniLM-L6-v2/\n--home does not move the cache.\n\nmodel_quantized.onnx\ntokenizer.json\n\nNo session data: model files only"
  class: tool
}

embedder: {
  label: "Embedder (runtime)\n\nLoads the model from the cache.\nThe runtime never touches the network.\nA missing model is a clean error\n(ModelMissing), never a silent download.\nCLI import then falls back to text only."
  class: tool
}

ingest_note: {
  label: "Ingest and search\nText parts and query text\nare embedded locally, on CPU.\nSetup alone does not backfill vectors."
  class: tool
}

remote -> part: "HTTPS download (setup only)"
setup -> remote: "drives the download"
part -> cache: "rename on digest match"
cache -> embedder: "loads (read-only)"
embedder -> ingest_note: "embeds text,\n384 dimensions"
