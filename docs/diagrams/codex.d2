title: Codex source adapter

root: {
  label: "Sensitive data: Root\n~/.codex"
  class: sensitive
}

index: {
  label: "Sensitive data: Threads index\n~/.codex/state_5.sqlite\nthreads and thread_spawn_edges tables\nread-only online backup\nSQLite sidecar coordination still applies"
  class: sensitive
}

snapshot: {
  label: "Sensitive data: Temporary snapshot\n<temp>/botspy-snapshot-<random>/snapshot.db\nQueried through a read-only connection\nRemoved when its reader closes"
  class: sensitive
}

diagnostics: {
  label: "Discovery and doctor issues\nMissing index, unreadable snapshot,\nand threads schema failures are reported.\nAn unreadable edge table is reported\nwithout hiding readable threads."
  class: tool
}

rollouts: {
  label: "Sensitive data: Rollout files\n~/.codex/sessions/YYYY/MM/DD/\nrollout-*.jsonl\none file per session"
  class: sensitive
}

missing: {
  label: "Missing rollout file\nskipped and counted"
  class: tool
}

parents: {
  label: "Spawn edges\nthread_spawn_edges table\nchild_thread_id → parent_thread_id\nParent links in the session graph"
  class: tool
}

adapter: {
  label: "CodexSource\nrollout byte offsets in memory,\nresume per session,\npartial trailing line held back"
  class: tool
}

ordering: {
  label: "Ordering\nEvery record has an explicit\nordinal field. Records are sorted\nby ordinal, not by file order."
  class: tool
}

mapping: {
  label: "Record mapping\n\nresponse_item, message user / assistant → Text\nresponse_item, message developer       → System part (origin: developer)\nresponse_item, reasoning summary       → Thinking\nfunction_call                          → ToolCall (arguments parsed)\nfunction_call_output                   → ToolResult (role: tool)\ntoken_usage_record                     → Usage (model, token counts)\ncompacted                              → CompactionWindow\ntask_complete                         → Turn (duration, time to first token)"
  class: tool
}

session: {
  label: "Unified Session\nmessages, parts, usage,\nparent links, provenance"
  class: tool
}

root -> index: "locates index"
index -> snapshot: "copies committed SQLite state"
snapshot -> rollouts: "rollout_path from threads\n(absolute or relative to root)"
rollouts -> adapter: "read record by record"
snapshot -> missing: "thread without a rollout file"
index -> diagnostics: "missing index or backup failure"
snapshot -> diagnostics: "query failures"
adapter -> ordering: "sorts by ordinal"
ordering -> mapping: "each record type"
mapping -> session: "extracted"
snapshot -> parents: "queries spawn-edge table"
parents -> session: "session graph"
