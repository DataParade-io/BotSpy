title: BotSpy - C4 context (level 1)

user: {
  label: User
  shape: person
}

botspy: {
  label: "BotSpy\nLocal CLI and library\nfor one machine"
  class: tool
}

agent_data: {
  label: "Sensitive data: coding agents on this machine\n\nClaude Code, Cursor, Codex,\nGrok Bot, Antigravity\n\nEach agent writes its session\ndata to its own local files"
  class: sensitive
}

store: {
  label: "Sensitive data: BotSpy local store\n\n~/.botspy/store.db\nCopies of session history:\nsessions, messages, parts,\nfull-text and vector indexes"
  shape: cylinder
  class: sensitive
}

user -> botspy: "Runs commands:\nsources, sessions, show, search,\nimport, doctor, snapshot, stats, scan"
botspy -> agent_data: "Reads session files\nand databases (read-only connection).\nSQLite sidecar coordination still applies.\nSensitive data: session-history content"
botspy -> store: "Ingest writes copies of\nsession history.\nSensitive data: session-history content"
botspy -> user: "Sessions, messages,\nand search hits\n(human, JSON, NDJSON).\nSensitive data: session-history content"
