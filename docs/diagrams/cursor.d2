title: Cursor source adapter

store: {
  label: "Sensitive data: Cursor store\nstate.vscdb in the application data\ndirectory (+ -wal, -shm)\nmacOS: ~/Library/Application Support/Cursor/User/globalStorage\nLinux: ~/.config/Cursor/User/globalStorage\nWindows: %APPDATA%/Cursor/User/globalStorage\nkey-value table: cursorDiskKV"
  class: sensitive
}

snap: {
  label: "Sensitive data: Snapshot copy\n<temp>/botspy-snapshot-<random>/snapshot.db\nprivate directory; reader owns its lifetime\nremoved when the reader closes"
  class: sensitive
}

cli_dir: {
  label: "Sensitive data: CLI transcripts\n~/.cursor/projects/<encoded-cwd>/agent-transcripts/\ncurrent: <session>/<session>.jsonl\n         <session>/subagents/<id>.jsonl\nolder: <session>.jsonl"
  class: sensitive
}

keys: {
  label: "Keys in cursorDiskKV\n\ncomposerHeaders        → composer list (id, last updated, name)\ncomposerData:<id>      → authoritative bubble order\nbubbleId:<cid>:<bid>   → one bubble\ntype 1 → user, type 2 → assistant, else unknown\nagentKv:blob:<sha256>  → content-addressed opaque blob"
  class: tool
}

bubbles: {
  label: "Bubble mapping\n\ntext            → Text\nthinking        → Thinking\ntoolFormerData  → ToolCall (name, parsed params)\ntoolResultBlob  → ToolResult (blob hash, container agentKv:blob)\nempty bubbles   → malformed, skipped"
  class: tool
}

cli_map: {
  label: "CLI transcript mapping\n\nrole assistant → Assistant; other roles → User\nmessage.content: text blocks → Text, tool_use blocks → ToolCall\n(older records: text, thinking, timestamp)\nno record timestamps: file mtime in file_modified_at\nsub-agent file → session <parent>--agent-<id>\nwith parent_id + sub-agent info"
  class: tool
}

discovery: {
  label: "Discovery\ncomposers with lastUpdatedAt.\nA composer changed when\nlastUpdatedAt moved."
  class: tool
}

kv_source: {
  label: "CursorSource\nreads the snapshot copy"
  class: tool
}

cli_source: {
  label: "CursorCliSource\nreads transcript files"
  class: tool
}

session: {
  label: "Unified Session\nmessages, parts, provenance"
  class: tool
}

store -> snap: "SQLite online backup\nread-only source connection;\nsidecar coordination still applies"
snap -> kv_source: "read-only queries"
cli_dir -> cli_source: "reads files"
kv_source -> keys: "key lookups"
keys -> bubbles: "bubble types"
bubbles -> session: "extracted"
cli_source -> cli_map: "record fields"
cli_map -> session: "extracted"
discovery -> store: "scans composer headers"
