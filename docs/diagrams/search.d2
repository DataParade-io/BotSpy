title: Search - text, semantic, hybrid

cli: {
  label: "BotSpy CLI\nsearch <query>\n--mode text | semantic | hybrid\n--db, --source (at most one),\n--project, --limit\n-o human | json | ndjson"
  class: tool
}

text_path: {
  label: "Text search (FTS5)\nQuery terms are quoted;\npunctuation and operators drop out.\nunicode61 tokenizer, implicit AND.\nSessions rank by matching-message\ncount, best bm25, then id.\nHit score = RRF 1 / (60 + rank)."
  class: tool
}

fts_table: {
  label: "Sensitive data: message_fts\nplaintext index"
  class: sensitive
}

sem_path: {
  label: "Semantic search\nQuery text goes through the embedder.\nSimilarity = 1 - cosine distance,\nclamped to [-1, 1].\nSimilarity floor: 0.3.\nAt most 4096 neighbor rows.\nRanking: best similarity, ties by id.\nWithout an embedder: a clean, empty\nsemantic result; text search is unaffected."
  class: tool
}

embedder: {
  label: "Embedder\nall-MiniLM-L6-v2, tract ONNX, CPU.\nWordpiece tokens, seq length 128,\nmean pooling, L2 normalized.\n384 dimensions."
  class: tool
}

models: {
  label: "Model cache\nBOTSPY_MODELS, otherwise\n\$HOME/.botspy/models\nall-MiniLM-L6-v2 subdirectory\n--home does not move this cache\n(no session data)"
  class: tool
}

vec_table: {
  label: "Sensitive data: message_vec (vec0)\nembeddings, cosine distance"
  class: sensitive
}

hybrid: {
  label: "Hybrid search\nFused score = text RRF 1 / (60 + rank)\n+ best cosine similarity.\nOrder: fused score, ties by id.\nText hits first, then semantic-only,\ndeduped by (session, message, part)."
  class: tool
}

output: {
  label: "Sensitive data: Search hits (JSON / NDJSON)\nsession_id, message_ordinal,\npart_ordinal, text, score"
  class: sensitive
}

cli -> text_path: "--mode text"
text_path -> fts_table: "MATCH query"
fts_table -> text_path: "bm25 ranks"
cli -> sem_path: "--mode semantic"
cli -> hybrid: "--mode hybrid"
sem_path -> embedder: "embed the query text"
embedder -> models: "loads model (read-only)"
embedder -> vec_table: "query vector"
vec_table -> sem_path: "nearest rows,\ncosine distance"
sem_path -> hybrid: "semantic ranks"
text_path -> hybrid: "text ranks"
text_path -> output: "text-mode hits"
sem_path -> output: "semantic-mode hits"
hybrid -> output: "hybrid-mode hits\nSensitive data: session history"
