title: BotSpy - C4 container (level 2)

machine: {
  label: Local machine

  user: {
    label: User
    shape: person
  }

  cli: {
    label: "BotSpy CLI\n\nsources, sessions, show, search,\nimport, doctor, snapshot, stats, scan\n\nReads agent conversation records.\nSQLite may create or touch sidecars.\nWrites its own store and snapshots."
    class: tool
  }

  agent_data: {
    label: "Sensitive data: agent session files\n\nClaude Code, Cursor, Codex,\nGrok Bot, Antigravity\n\nEach agent's own files and\ndatabases under the selected home"
    class: sensitive
  }

  snapshots: {
    label: "Sensitive data: snapshot copies\n\nAutomatic: <temp>/botspy-snapshot-<random>/snapshot.db\nCursor, Codex, Antigravity\nPrivate; removed when the reader closes.\n\nExplicit: <home>/.botspy/snapshots/<source>/snapshot.db\n(or --out); retained until removed."
    class: sensitive
  }

  store: {
    label: "Sensitive data: local store\n\n<home>/.botspy/store.db\n(+ store.db-wal, store.db-shm)\n\nSQLite in WAL mode:\nsessions, messages, parts,\nFTS5 index, vector index"
    shape: cylinder
    class: sensitive
  }

  models: {
    label: "Model cache\n\nBOTSPY_MODELS or \$HOME/.botspy/models\nthen all-MiniLM-L6-v2/\n--home does not move this cache.\n\nNo session data: model files only"
    class: tool
  }
}

machine.user -> machine.cli: "Runs commands"
machine.cli -> machine.agent_data: "Adapters read sources (read-only).\nSensitive data: session history"
machine.cli -> machine.snapshots: "Snapshot module copies\nlive SQLite files.\nSensitive data: live store pages"
machine.snapshots -> machine.cli: "Adapters read the automatic copy.\nCrashes can leave private copies.\nSensitive data: session history"
machine.cli -> machine.store: "Ingest writes; queries read.\nSensitive data: session history"
machine.cli -> machine.models: "Embedder loads model\nfiles (read-only)"
machine.cli -> machine.user: "Sessions, messages,\nsearch hits\n(human, JSON, NDJSON).\nSensitive data: session history"
