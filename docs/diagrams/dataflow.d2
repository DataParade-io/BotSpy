title: Data flow - from agent files to query results

# --- The five sources, with their exact local paths ---

cc_files: {
  label: "Sensitive data: Claude Code files\n\n~/.claude/projects/\n<encoded-cwd>/<session>.jsonl\nsubagents/agent-*.jsonl (skipped)"
  class: sensitive
}

cursor_files: {
  label: "Sensitive data: Cursor files\n\n~/.cursor/state.vscdb\n(+ -wal, -shm)\n~/.cursor/projects/\n<encoded-cwd>/agent-transcripts/*.jsonl"
  class: sensitive
}

codex_files: {
  label: "Sensitive data: Codex files\n\n~/.codex/state_5.sqlite\n~/.codex/sessions/YYYY/MM/DD/\nrollout-*.jsonl"
  class: sensitive
}

grok_files: {
  label: "Sensitive data: Grok Bot files\n\n~/.grok/sand-client-persistence/\nentry logs (*.json),\nroster.json, cloud-agents.json"
  class: sensitive
}

ag_files: {
  label: "Sensitive data: Antigravity files\n\n~/.gemini/antigravity/\nconversation_summaries.db\nbrain/<id>/payload.db\nbrain/<id>/.system_generated/logs/\ntranscript.jsonl"
  class: sensitive
}

# --- Snapshot copies that BotSpy creates ---

cursor_snap: {
  label: "Sensitive data: Cursor snapshot copy\n\n<temp>/botspy-snapshot-<random>/snapshot.db\nprivate; removed when reader closes"
  class: sensitive
}

ag_snap: {
  label: "Sensitive data: Antigravity snapshot copies\n\n<temp>/botspy-snapshot-<random>/snapshot.db\nprivate; removed when reader closes"
  class: sensitive
}

codex_snap: {
  label: "Sensitive data: Codex index copy\n\n<temp>/botspy-snapshot-<random>/snapshot.db\nprivate; removed when reader closes"
  class: sensitive
}

snapshot_note: {
  label: "SQLite read-only connections can\ncreate or update shared-memory sidecars.\nCrashes can leave private temporary copies."
  class: tool
}

snap_cache: {
  label: "Sensitive data: snapshot cache\n\n<home>/.botspy/snapshots/\n<source>/snapshot.db\nwritten by the snapshot verb"
  class: sensitive
}

# --- The pipeline ---

adapters: {
  label: "Source adapters\nclaude_code, cursor, codex,\ngrok_bot, antigravity"
  class: tool
}

schema: {
  label: "Unified schema\nSession / Message / Part\n(provenance, usage, costs)"
  class: tool
}

ingest: {
  label: "Ingest\none transaction per import,\ncontent-hash change detection"
  class: tool
}

store: {
  label: "Sensitive data: local store  <home>/.botspy/store.db  (+ -wal, -shm)"

  sessions: {
    label: "Sensitive data: sessions\nfull session JSON"
    class: sensitive
  }
  messages: {
    label: "Sensitive data: messages\nfull message JSON"
    class: sensitive
  }
  parts: {
    label: "Sensitive data: parts\nplaintext part text"
    class: sensitive
  }
  message_fts: {
    label: "Sensitive data: message_fts\nplaintext FTS5 index"
    class: sensitive
  }
  message_vec: {
    label: "Sensitive data: message_vec\nembeddings (derived,\nnot plaintext)"
    class: sensitive
  }
  meta: {
    label: "meta\nschema version,\nembedding model id"
    class: tool
  }
}

embedder: {
  label: "Embedder\nall-MiniLM-L6-v2,\n384 dimensions"
  class: tool
}

models: {
  label: "Model cache\nBOTSPY_MODELS or \$HOME/.botspy/models\nthen all-MiniLM-L6-v2/\n--home does not move the cache\n(no session data)"
  class: tool
}

query: {
  label: "Query surface\nsessions, messages, open, parts;\ntext (FTS5), semantic (sqlite-vec),\nhybrid search"
  class: tool
}

cli: {
  label: "BotSpy CLI\nsessions, show, search, stats, ..."
  class: tool
}

output: {
  label: "Sensitive data: CLI output\nstdout / JSON / NDJSON\nsessions, messages, search hits"
  class: sensitive
}

privacy_example: {
  label: "Privacy example (examples/privacy)\nreads sessions, redacts, then scores;\nwrites to stdout only, no transcript text to disk"
  class: tool
}

leftblock: {
  label: "Sensitive data: LeftBlock process\nlocal leftblock scan --jsonl\nprivate 0700 temp dir, deleted after;\nno network (--deep downloads model\nweights on first use only)"
  class: sensitive
}

user: {
  label: User
  shape: person
}

# --- Flows ---

cursor_files -> cursor_snap: "SQLite online backup\n(read-only source connection).\nSensitive data: live store pages"
cursor_snap -> adapters: "adapter reads the copy.\nSensitive data: session history"
ag_files -> ag_snap: "SQLite online backup\n(read-only source connection).\nSensitive data: live store pages"
ag_snap -> adapters: "adapter reads the copy.\nSensitive data: session history"
codex_files -> codex_snap: "online backup of state_5.sqlite.\nSensitive data: thread index"
codex_snap -> adapters: "reads thread and spawn-edge tables.\nSensitive data: session history"
cc_files -> adapters: "reads transcripts.\nSensitive data: session history"
codex_files -> adapters: "reads rollout text files.\nSensitive data: session history"
grok_files -> adapters: "reads entry logs.\nSensitive data: session history"

adapters -> schema: "unified session objects.\nSensitive data: session history"
schema -> ingest: "sessions to store.\nSensitive data: session history"
ingest -> store.sessions: "rows.\nSensitive data: session history"
ingest -> store.messages: "rows.\nSensitive data: session history"
ingest -> store.parts: "rows.\nSensitive data: plaintext text"
ingest -> store.message_fts: "text rows (plaintext).\nSensitive data: plaintext text"
ingest -> embedder: "text parts to embed.\nSensitive data: plaintext text"
embedder -> models: "loads model (read-only)"
embedder -> store.message_vec: "embeddings\n(derived, not plaintext)"

user -> cli: "runs commands"
cli -> snap_cache: "snapshot verb copies\na source database.\nSensitive data: live store pages"
cli -> query: "stored sessions, search, stats"
query -> store: "reads (WAL readers).\nSensitive data: session history"
query -> embedder: "embeds the query text\n(semantic, hybrid)"
query -> output: "sessions, messages, hits.\nSensitive data: session history"
output -> user: "displayed.\nSensitive data: session history"

schema -> privacy_example: "optional example reads sessions\nthrough the public API, no store.\nSensitive data: session history"
privacy_example -> leftblock: "text-bearing parts as JSONL on stdin.\nSensitive data: plaintext text"
leftblock -> privacy_example: "findings: byte ranges, rule, kind.\nNever the matched value"
privacy_example -> output: "audit counts, or redacted text.\nSensitive data: redacted session text"
